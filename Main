import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score
import cv2
import numpy as np
import matplotlib.pyplot as plt

digits = pd.read_csv('/kaggle/input/datasets/rakuraku678/mnist-60000-hand-written-number-images/mnist_train.csv') # dataset from Kaggle mnist

y = digits.iloc[:, 0]
X = digits.iloc[:, 1:]

X = X / 255.0

X_train, X_val, y_train, y_val = train_test_split(X, y, random_state=0)

model = RandomForestClassifier(random_state=0)
model.fit(X_train, y_train)

preds = model.predict(X_val)
print("Accuracy:", accuracy_score(y_val, preds))

img = cv2.imread('...')

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) 
img_resized = cv2.resize(gray, (28, 28))     
img_resized = 255 - img_resized              
img_resized = img_resized / 255.0            
img_flat = img_resized.reshape(1, -1)        

prediction = model.predict(img_flat)
print("Prediction:", prediction[0])

plt.imshow(img_resized, cmap='gray')
plt.title("Model Input")
plt.show()
